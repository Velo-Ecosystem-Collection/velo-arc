# ─── GitHub OAuth ────────────────────────────────────────────────
# Get this from GitHub Developer Settings -> OAuth Apps
VITE_GITHUB_CLIENT_ID=

# ─── Backend Configuration ───────────────────────────────────────
# When running in local development, it defaults to /api (proxied by Vite).
# In production (e.g., Vercel), set this to your full backend URL (e.g., https://api.yoursite.com).
VITE_API_BASE=
BACKEND_URL=

# Event-only Arc session mode (enable only for the workshop deployment).
# Use the HTTPS API URL with no trailing slash.
VITE_ARC_EVENT_MODE=false
VITE_VELO_URL=https://velo.example

VITE_OPENROUTER_API_KEY
